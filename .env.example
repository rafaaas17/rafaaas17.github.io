# Plantilla de las variables que necesita compose.yaml.
#
# Este archivo SÍ se commitea: solo documenta qué variables hacen falta.
# El archivo .env, que es el que las tiene de verdad, NO se commitea nunca:
# está en .gitignore.
#
#   En local:       cp .env.example .env   y cambia la contraseña
#   En Codespaces:  nada, .devcontainer/ genera el .env solo, con una
#                   contraseña aleatoria distinta en cada Codespace.

# Tienen que coincidir con lo que la API espera en DB_NAME y DB_USER.
POSTGRES_DB=libro
POSTGRES_USER=app

# Credencial de desarrollo, no de producción: vive solo en tu máquina y solo
# la alcanza la red interna de compose, que no publica el puerto 5432.
POSTGRES_PASSWORD=cambia-esta-contrasena
